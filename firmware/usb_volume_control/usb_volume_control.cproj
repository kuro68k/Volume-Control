        </dependencies>
      </framework-data>
    </AsfFrameworkConfig>
    <avrtool>com.atmel.avrdbg.tool.atmelice</avrtool>
    <avrtoolserialnumber>J42700048768</avrtoolserialnumber>
    <avrdeviceexpectedsignature>0x1E943B</avrdeviceexpectedsignature>
